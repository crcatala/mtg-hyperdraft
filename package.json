{
  "name": "mtg-hyperdraft",
  "version": "0.1.0",
  "private": true,
  "description": "HyperDraft — browser MTG cube drafting + 3D tabletop for up to 4 friends (React Three Fiber + Cloudflare Durable Objects)",
  "type": "module",
  "scripts": {
    "predev": "node scripts/ensure-dev-vars.mjs",
    "dev": "vite",
    "build": "vite build",
    "prepreview": "node scripts/ensure-dev-vars.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "deploy": "vite build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "invite:new": "node scripts/new-invite.mjs",
    "presets:build": "node scripts/build-presets.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.8.1",
    "mana-font": "^1.18.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.60.0",
    "@cloudflare/workers-types": "^5.20260924.1",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.1",
    "wrangler": "^4.139.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260923.1": true
  }
}
